APP_NAME=VWA-TPMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true

BACKUP_NAME=vwa-tpms
# Private location outside the web root; copy backups to a separate host/volume.
# BACKUP_ROOT=/var/backups/vwa-tpms
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAIL_TO=
# Directory containing mysqldump (without the executable name).
DB_DUMP_BINARY_PATH=
# Keep retry_after above the longest import job timeout (3600 seconds).
DB_QUEUE_RETRY_AFTER=3900
APP_URL=http://localhost
APP_TIMEZONE=Asia/Bangkok
WEB_SCHEDULE_TIMEZONE=Asia/Bangkok

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=vwa_tpms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MODELAPI_API_KEY=
MODELAPI_MODEL=gpt-6-luna
MODELAPI_BASE_URL=https://modelapi.vn/v1


MODELAPI_TIMEOUT=180
MODELAPI_PDF_PYTHON=
MODELAPI_PDF_BATCH_PAGES=1

# Require a completed, approved ISO review before curriculum publication.
CURRICULUM_REQUIRE_ISO_REVIEW=false
CURRICULUM_ALLOW_RETROACTIVE_EFFECTIVE_DATE=false
